# Compiled class file
*.class

# Log file
*.log

# BlueJ files
*.ctxt

# Mobile Tools for Java (J2ME)
.mtj.tmp/

# Package Files #
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# Gradle wrapper jar is a tracked bootstrap component, not a build artifact.
!gradle/wrapper/gradle-wrapper.jar

# Bundled datapacks under src/main/resources/datapacks/*.zip are source content
# that ships inside the plugin jar; un-ignore them so they are tracked.
!src/main/resources/datapacks/
!src/main/resources/datapacks/*.zip

# virtual machine crash logs, see http://www.java.com/en/download/help/error_hotspot.xml
hs_err_pid*

